# ---------- Security headers ----------
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Baseline CSP for a static SPA (tighten to your real needs first!)
  # If something breaks (fonts, analytics, images from CDN), add those origins.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'none'"

  # HSTS: enable ONLY if the whole site is HTTPS 24/7.
  # If ALL subdomains are also HTTPS, you may add 'includeSubDomains; preload'
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Disable directory listing
Options -Indexes

# Optional: long cache for built assets (adjust extensions as needed)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
</IfModule>

# ---------- SPA rewrites (keep these) ----------
RewriteEngine On
RewriteBase /
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]